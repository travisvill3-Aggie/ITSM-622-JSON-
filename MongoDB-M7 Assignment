exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
export DEBIAN_FRONTEND=noninteractive
set -euo pipefail

# ========================
# VARIABLES - UPDATE THESE
# ========================
LINUX_USER="tvillanueva"
UIN="529004769"
HOME_DIR="/home/${LINUX_USER}"
DATA_URL="https://622.gomillion.org/data/${UIN}.zip"
MONGO_DB="FurnitureDB"

# CHANGE THIS TO YOUR ACTUAL RAW GITHUB FOLDER
RAW_BASE="https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/main"

ETL_URL="${RAW_BASE}/etl.sql"
VIEWS_URL="${RAW_BASE}/views.sql"
JSON_URL="${RAW_BASE}/json.sql"

echo "### Starting ISTM 622 MongoDB milestone setup ###"

# ========================
# SYSTEM PACKAGES
# ========================
apt-get update -y
apt-get upgrade -y
apt-get install -y \
  curl wget unzip gnupg2 ca-certificates lsb-release apt-transport-https \
  software-properties-common cron

# ========================
# INSTALL MARIADB
# ========================
mkdir -p /etc/apt/keyrings
curl -LsS https://mariadb.org/mariadb_release_signing_key.pgp \
  | gpg --dearmor -o /etc/apt/keyrings/mariadb.gpg

cat > /etc/apt/sources.list.d/mariadb.list <<EOF
deb [signed-by=/etc/apt/keyrings/mariadb.gpg] https://deb.mariadb.org/11.8/ubuntu noble main
EOF

apt-get update -y
apt-get install -y mariadb-server

# ========================
# CONFIGURE MARIADB
# ========================
mkdir -p /var/lib/mysql-files
chown mysql:mysql /var/lib/mysql-files
chmod 750 /var/lib/mysql-files

cat > /etc/mysql/mariadb.conf.d/99-istm622.cnf <<EOF
[mysqld]
local_infile=1
secure_file_priv=/var/lib/mysql-files
EOF

systemctl enable mariadb
systemctl restart mariadb
sleep 5

# ========================
# INSTALL MONGODB COMMUNITY
# ========================
curl -fsSL https://pgp.mongodb.com/server-7.0.asc \
  | gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor

cat > /etc/apt/sources.list.d/mongodb-org-7.0.list <<EOF
deb [ signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse
EOF

apt-get update -y
apt-get install -y mongodb-org

systemctl enable mongod
systemctl start mongod
sleep 5

# ========================
# CREATE USER
# ========================
id -u "${LINUX_USER}" &>/dev/null || useradd -m -s /bin/bash "${LINUX_USER}"
chmod 755 "${HOME_DIR}"

# ========================
# DOWNLOAD SOURCE DATA
# ========================
echo "### Downloading CSV source files ###"
sudo -u "${LINUX_USER}" wget -O "${HOME_DIR}/${UIN}.zip" "${DATA_URL}"

if [ ! -s "${HOME_DIR}/${UIN}.zip" ]; then
  echo "ERROR: Source zip download failed."
  exit 1
fi

sudo -u "${LINUX_USER}" unzip -o "${HOME_DIR}/${UIN}.zip" -d "${HOME_DIR}"

# ========================
# DOWNLOAD SQL FILES FROM GITHUB
# ========================
echo "### Downloading SQL files from GitHub ###"
sudo -u "${LINUX_USER}" wget -O "${HOME_DIR}/etl.sql" "${ETL_URL}"
sudo -u "${LINUX_USER}" wget -O "${HOME_DIR}/views.sql" "${VIEWS_URL}"
sudo -u "${LINUX_USER}" wget -O "${HOME_DIR}/json.sql" "${JSON_URL}"

chown "${LINUX_USER}:${LINUX_USER}" \
  "${HOME_DIR}/etl.sql" \
  "${HOME_DIR}/views.sql" \
  "${HOME_DIR}/json.sql"

chmod 644 \
  "${HOME_DIR}/etl.sql" \
  "${HOME_DIR}/views.sql" \
  "${HOME_DIR}/json.sql"

# ========================
# BUILD MARIADB DATABASE
# ========================
echo "### Building POS database ###"
cd "${HOME_DIR}"
mariadb --local-infile=1 < "${HOME_DIR}/views.sql"

# ========================
# WRITE sync.sh
# ========================
echo "### Writing sync.sh ###"
cat > "${HOME_DIR}/sync.sh" <<'EOF'
#!/bin/bash
set -euo pipefail

MYSQL_JSON_DIR="/var/lib/mysql-files"
HOME_DIR="/home/tvillanueva"
MONGO_DB="FurnitureDB"
LOG_FILE="/var/log/sync.log"

exec >> "$LOG_FILE" 2>&1

echo "=================================================="
echo "sync.sh started at $(date)"

echo "[1/3] CLEAN - deleting old JSON files"
rm -f "${MYSQL_JSON_DIR}/prod.json" \
      "${MYSQL_JSON_DIR}/cust.json" \
      "${MYSQL_JSON_DIR}/custom1.json" \
      "${MYSQL_JSON_DIR}/custom2.json"

echo "[2/3] EXTRACT - regenerating JSON from MariaDB"
cd "${HOME_DIR}"
mariadb < "${HOME_DIR}/json.sql"

echo "[3/3] LOAD - importing into MongoDB"
mongoimport --db "${MONGO_DB}" --collection Products  --file "${MYSQL_JSON_DIR}/prod.json"    --drop
mongoimport --db "${MONGO_DB}" --collection Customers --file "${MYSQL_JSON_DIR}/cust.json"    --drop
mongoimport --db "${MONGO_DB}" --collection Custom1   --file "${MYSQL_JSON_DIR}/custom1.json" --drop
mongoimport --db "${MONGO_DB}" --collection Custom2   --file "${MYSQL_JSON_DIR}/custom2.json" --drop

echo "sync.sh completed at $(date)"
echo "=================================================="
EOF

chmod 755 "${HOME_DIR}/sync.sh"
chown "${LINUX_USER}:${LINUX_USER}" "${HOME_DIR}/sync.sh"

# ========================
# RUN INITIAL SYNC
# ========================
echo "### Running initial sync ###"
bash "${HOME_DIR}/sync.sh"

# ========================
# SCHEDULE CRON
# ========================
echo "### Scheduling cron job ###"
cat > /etc/cron.d/istm622-sync <<EOF
* * * * * root ${HOME_DIR}/sync.sh
EOF

chmod 644 /etc/cron.d/istm622-sync
systemctl enable cron
systemctl restart cron

# ========================
# FINAL VALIDATION
# ========================
echo "### Validation output ###"
systemctl status mariadb --no-pager || true
systemctl status mongod --no-pager || true
ls -l /var/lib/mysql-files/ || true
cat /etc/cron.d/istm622-sync || true
mongosh --quiet --eval "db.getSiblingDB(\"${MONGO_DB}\").Customers.countDocuments()"

echo "### Setup complete ###"
echo "### Check /var/log/user-data.log and /var/log/sync.log if needed ###"
